<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>dnn-iis</id>
    <version>0.0.1</version>
    <title>DotNetNorth IIS Homepage</title>
    <authors>Steve Futcher</authors>
    <summary>Replaces IIS Homepage with DNN Logo</summary>
    <description>Overwites C:\inetput\wwwroot\iistart.htm with a custom demo page</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
